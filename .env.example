# Contoh publik: tidak memuat token/kredensial produksi.
# Lokal: salin menjadi .env; Railway: isi Variables secara privat.
# Pertahankan nilai lama saat update, terutama database dan kunci enkripsi.
BOT_TOKEN=GANTI_DENGAN_TOKEN_BOT
ADMIN_ID=0
ADMIN_USERNAME=admin
PAYMENT_NOTE=QRIS Maboyy Digital
PORT=8080

# Lokal memakai path relatif. Railway Volume /data:
# DB_PATH=/data/shop.db
# BACKUP_DIR=/data/backups
DB_PATH=shop.db
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=48
BACKUP_RETENTION=20
ORDER_RESERVATION_MINUTES=15
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
REQUIRED_CHANNEL_NAME=Channel Maboyy Digital
STOCK_CHANNEL_ID=
PUBLIC_BASE_URL=
HOSTING_PLAN_NAME=
HOSTING_PLAN_EXPIRES_AT=

# Gateway pembayaran opsional: pertahankan konfigurasi provider resmi.
SHOPEEPAY_ENABLED=false
SHOPEEPAY_BASE_URL=
SHOPEEPAY_CLIENT_ID=
SHOPEEPAY_CLIENT_SECRET=
SHOPEEPAY_MERCHANT_ID=
SHOPEEPAY_STORE_ID=
SHOPEEPAY_TERMINAL_ID=
# Nilai PEM multiline dapat memakai escape \n pada variabel privat.
SHOPEEPAY_PRIVATE_KEY=
SHOPEEPAY_PUBLIC_KEY=

# Tools AM: endpoint API yang diizinkan oleh provider Anda.
TOOLS_PROVIDER_ENABLED=false
TOOLS_PROVIDER_NAME=Authorized Provider
TOOLS_PROVIDER_API_KEY=
# bearer atau x-api-key; sesuaikan kontrak provider existing.
TOOLS_PROVIDER_AUTH_MODE=bearer
TOOLS_PROVIDER_MAGICLINK_URL=
TOOLS_PROVIDER_VERIFY_URL=
TOOLS_PROVIDER_APPLY_URL=
TOOLS_PROVIDER_APPLY_STATUS_URL=
TOOLS_PROVIDER_STATUS_URL=
TOOLS_PROVIDER_PROVISION_URL=
TOOLS_PROVIDER_TIMEOUT_SECONDS=12
TOOLS_PROVIDER_APPLY_TIMEOUT_SECONDS=30
TOOLS_PROVIDER_MAX_RETRIES=1
TOOLS_PROVIDER_REQUEST_COOLDOWN_SECONDS=600
TOOLS_PROVIDER_MAX_RESPONSE_CHARS=2000
TOOLS_PROVIDER_HOURLY_LIMIT=15
TOOLS_PROVIDER_REQUESTS_PER_ACCOUNT=3
TOOLS_SESSION_EXPIRY_MINUTES=15
TOOLS_EMAIL_LOCK_SECONDS=300
TOOLS_PROVIDER_STATUS_CACHE_SECONDS=60
TOOLS_PROVIDER_POLL_ATTEMPTS=4
TOOLS_PROVIDER_POLL_INTERVAL_SECONDS=3
TOOLS_PROVIDER_TEMP_RETRIES=2
TEMPMAIL_ENABLED=true
TEMPMAIL_PROVIDER=grabmail
TEMPMAIL_TIMEOUT_SECONDS=12
# Opsional; fallback BOT_TOKEN. Jangan ubah kunci sesi yang sudah dipakai.
TEMPMAIL_ENCRYPTION_KEY=
TOOLS_AUTO_AM_MAIL_PROVIDER=grabmail
TOOLS_AUTO_AM_MAIL_WAIT_SECONDS=90
TOOLS_AUTO_AM_POLL_SECONDS=3

# Cek MLBB di /tools (ALU API https://aluu.in/docs, menu Name Check).
# Isi key akun ALU privat dan whitelist IP keluar server pada dashboard API.
# Tidak memakai key Tools AM, BuzzerPanel, atau gateway pembayaran.
MLBB_API_KEY=
MLBB_ENABLED=false
MLBB_HTTP_TIMEOUT_SECONDS=12
MLBB_CACHE_SECONDS=60
MLBB_DAILY_LIMIT=20
MLBB_COOLDOWN_SECONDS=10
# Owner dapat mengubah aktif/nonaktif dan limit melalui /tools -> Cek MLBB.
# Pengaturan tersimpan di SQLite; nilai ENV di atas menjadi default awal.

# OTP opsional; base URL hanya mendukung endpoint resmi ini.
SMSCODE_API_TOKEN=
SMSCODE_API_BASE_URL=https://api.smscode.gg/v1
SMSCODE_OTP_ENABLED=true
SMSCODE_WEBHOOK_PUBLIC_URL=
# Opsional: secret resmi provider, bukan secret buatan sendiri.
SMSCODE_WEBHOOK_SECRET=
OTP_MARKUP_MODE=percent
OTP_MARKUP_PERCENT=25
OTP_MARKUP_FIXED_IDR=0
OTP_PRICE_ROUNDING_IDR=100
OTP_MAX_ACTIVE_ORDERS_PER_USER=2
OTP_MAX_PROVIDER_PRICE_IDR=20000
OTP_POLL_INTERVAL_SECONDS=10
OTP_QUOTE_TTL_SECONDS=60
OTP_HTTP_TIMEOUT_SECONDS=15
OTP_DELIVERY_MAX_RETRIES=8
# Opsional; fallback TEMPMAIL_ENCRYPTION_KEY kemudian BOT_TOKEN.
OTP_STORAGE_ENCRYPTION_KEY=
OTP_SMS_RETENTION_HOURS=24
OTP_MAX_PURCHASES_PER_HOUR=60
OTP_PURCHASE_COOLDOWN_SECONDS=5

# Sosmed BuzzerPanel: kredensial akun privat; default belum aktif.
SOSMED_ENABLED=false
BUZZERPANEL_API_KEY=
BUZZERPANEL_SECRET_KEY=
BUZZERPANEL_API_URL=https://buzzerpanel.id/api/json.php
# Opsional jika API tidak memuat currency/unit: isi hanya setelah dikonfirmasi akun.
# Bisa dikonfirmasi terpisah melalui /sosmed → Status API → Mata Uang & Satuan.
# Nilai yang didukung: IDR dan 1000; kosong berarti belum diketahui.
BUZZERPANEL_CURRENCY=
SOSMED_RATE_UNIT=
# Opsional: tombol Periksa & Buka Toko memvalidasi API/katalog dan menyimpan hasil.
# Flag manual tidak wajib setelah pemeriksaan ON berhasil.
SOSMED_API_CONTRACT_VERIFIED=false
# Kompatibilitas: Status API memverifikasi kontrak refill/status_refill per akun
# setelah profile/katalog terbaca. Pengaturan Jeda/Aktifkan Refill tersimpan di DB.
# False di sini bukan error; pengaturan owner tersimpan diprioritaskan.
SOSMED_REFILL_API_VERIFIED=false
SOSMED_MARKUP_MODE=percent
SOSMED_MARKUP_PERCENT=25
SOSMED_MARKUP_NOMINAL_IDR=0
SOSMED_PRICE_ROUNDING_IDR=100
SOSMED_MIN_SELLING_PRICE_IDR=1000
SOSMED_MAX_QUANTITY=10000000
SOSMED_MAX_ACTIVE_ORDERS_PER_USER=5
SOSMED_CATALOG_CACHE_SECONDS=600
SOSMED_QUOTE_TTL_SECONDS=120
SOSMED_STATUS_POLL_SECONDS=120
SOSMED_HTTP_TIMEOUT_SECONDS=30

# QRIS Otomatis — KlikQRIS. Awali dengan gateway biasa; jangan isi token/cookie Shopee.
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
KLIKQRIS_ENABLED=false
KLIKQRIS_MODE=gateway
# Sandbox tidak boleh mengkredit wallet atau mengirim produk nyata.
KLIKQRIS_SANDBOX=false
# Opsional; default PUBLIC_BASE_URL + /webhooks/klikqris.
# Railway: kolom Value cukup https://DOMAIN_BOT_ANDA/webhooks/klikqris, tanpa NAMA_VARIABEL=.
KLIKQRIS_WEBHOOK_URL=
KLIKQRIS_HTTP_TIMEOUT_SECONDS=15
KLIKQRIS_POLL_INTERVAL_SECONDS=15
